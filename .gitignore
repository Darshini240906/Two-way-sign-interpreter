# --- Large raw training/animation data (keep structure, not content) ---
datasets/landmark_samples/**/*.webm
datasets/landmark_samples/**/*.jpg
datasets/landmark_samples/**/*.jpeg
datasets/landmark_samples/**/*.png
!datasets/landmark_samples/**/.gitkeep

# Recorded animation clips can be large too — uncomment if you don't
# want 46 JSON files bloating the repo (they're regenerable via capture-tool):
# assets/signs/*.json
# assets/letters/*.json

