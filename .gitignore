# --- Node / frontend ---
node_modules/
dist/
.vite/
*.local

# --- Python / backend ---
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.venv/
venv/
env/
backend/models/*.h5
backend/models/*.pkl
!backend/models/.gitkeep

# --- Env / secrets ---
.env
.env.*
